<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Here</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        /* .register-button {
            border-radius: 5px;
            border: 1px solid blue;
            color: black;
            background-color: #f3f3f3;
            font-family: system-ui;
            font-weight: 600;
            font-variant: small-caps;
        } */
        .register-button {
            border-radius: 15px;
            border: white;
            color: black;
            background-color: #f3f3f3;
            font-size: 20px;
        }

        .register-p {
            font-family: system-ui;
            font-size: 16px;
            font-weight: 400;
        }

        .register-h1 {
            font-family: system-ui;
            font-size: 35px;
            font-variant: small-caps;
            font-weight: 700;
        }

        .img-register {
            width: 100%;
            height: 570px;
            filter: drop-shadow(2px 4px 6px black);
        }

        .register-social-icon {
            height: 20px;
            height: 20px;
            margin-inline: 5px;
        }

        .register-social-icon:hover {
            transform: scale(1.5);
            transition: 0.5s;
        }

        .register-txt {
            border: none;
            border-bottom: 2px solid black;
            outline: none;
            box-shadow: none;
            width: 60%;
            padding: 5px;
        }

        /* popup box */

        .popup-reg {
            width: 400px;
            background-color: white;
            border-radius: 6px;
            position: fixed;
            top: 0%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.1);
            text-align: center;
            padding: 0 30px 30px;
            color: #333;
            visibility: hidden;
            transition: transform 0.4s, top 0.4s;
            z-index: 1;
            border: 1px solid black;
            box-shadow: 0px 10px 10px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
        }

        .popup-reg img {
            width: 70px;
            height: 70px;
            /* margin-top: -50px; */
            margin-top: 20px;
            border-radius: -50px;

        }

        .popup-reg h2 {
            font-size: 38px;
            font-weight: 500;
            margin: 30px 0 10px;
        }

        .popup-reg button {
            width: 100%;
            margin-top: 50px;
            padding: 10px 0;
            background-color: #198754;
            color: white;
            border: 0;
            outline: none;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);
        }

        .open-popreg {
            visibility: visible;
            top: 50%;
            transform: translate(-50%, -50%) scale(1);
        }
    </style>
    
</head>

<body>
   
    <div>
        <div><%- include('myheader') %></div><br><br>
        <div class="container mt-5">
            <div class="row">
                <div class="col-sm-7 mt-5">
                    <image src="/create-acc" class="img-register">
                </div>
                <div class="col-sm-5 mt-5">
                <form name="myForm" action="http://localhost:3000/Registration/Show_regi" method="POST" class="needs-validation" novalidate>
                    <!-- flash message -->
                    <% if(message.length > 0) { %>
                        <div class="alert alert-danger">
                            <%= message %>
                        </div>
                        <% } %>
                    <h1 class="register-h1">Welcome Back :)</h1>
                    <p class="register-p">To Keep Connected with us please enter the personal infromation🔔</p>
                    
                    <!-- <div class="form-group">
                        <input type="file" class="register-txt" name="Profile_img">
                    </div><br> -->
                    <div class="form-group">
                        <input type="text" class="form-control" id="uname" name="user_name" placeholder="User Name" required >
                        
                    </div><br>
                    <div class="form-group">
                        <input type="email" class="form-control" id="mail" name="email" placeholder="Email" required >
                        
                    </div><br>
                    <div class="form-group">
                        
                        <input type="tel" placeholder="Phone No" id="phone" class="form-control"  name="ph_no" pattern="^\d{10}$" required>
                    </div><br>
                    <div class="form-group">
                        <input type="text" class="form-control" id="state" name="state" placeholder="State" required >
                        
                    </div><br>
                    <div class="form-group">
                        <input type="text" class="form-control" id="city" name="city" placeholder="city" required >
                        
                    </div><br>
                    <div class="form-group">
                        <input type="password" class="form-control" id="pass" name="pwd" placeholder="Password" required>
                        
                    </div><br>
                    <div>
                        <a href="http://localhost:3000/Login" class="btn btn-outline-primary">Cancel</a>&nbsp;&nbsp;
                        <input type="submit" value="Submit" onclick="opensubmit()" onclick="onsubmit()" class="btn btn-outline-primary">
                    </div><br>
                </form>    
                    <div>
                        <p class="register-p">or you can join with</p>
                        <image src="/google" class="register-social-icon">
                            <image src="/facebook" class="register-social-icon">
                                <image src="/twitter" class="register-social-icon">
                    </div>
                
                </div>
            </div>
        </div>
        <div class="mt-5"><%- include('myfooter') %></div>
        <div class="popup-reg" id="pop_up">
            <img src="/check" height="5%" width="5%">
            <h2>Thank you</h2>
            <p>your details have been successfully submited.</p>
            <a href="http://localhost:3000/Login"><button type="submit" onclick="closesubmit()" class="btn btn-outline-primary">Ok</button></a>
        </div>
        <script>
            
        </script>
        <script>
            let pop_up = document.getElementById("pop_up");

            function opensubmit()
            {
                var uname=document.getElementById("uname").value;
                var mail=document.getElementById("mail").value;
                var phone=document.getElementById("phone").value;
                var state=document.getElementById("state").value;
                var city=document.getElementById("city").value;
                var pass=document.getElementById("pass").value;
                
                if(uname=="")
                    alert("Please fill User Name !");
                else if(mail=="")
                    alert("Please fill Email !");
                else if(phone=="")
                    alert("Please fill Phone number !");
                else if(phone.length!=10)
                    alert("Invalid Phone number Please Enter only 10 digits number!");
                else if(state=="")
                    alert("Please fill State !");
                else if(city=="")
                    alert("Please fill City !");
                    else if(pass=="")
                    alert("Please fill Password !");
                else 
                    pop_up.classList.add("open-popreg");
            }

            function closesubmit() {
                pop_up.classList.remove("open-popreg");
            }
        </script>
         <!-- validation -->
     <script>
        // Example starter JavaScript for disabling form submissions if there are invalid fields
        (function () {
            'use strict'

        // Fetch all the forms we want to apply custom Bootstrap validation styles to
        var forms = document.querySelectorAll('.needs-validation')

        // Loop over them and prevent submission
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
                }

                form.classList.add('was-validated')
            }, false)
            })
        })()
    </script>
    </div>
   
</body>

</html>
