    <script>
        let pop_up3 = document.getElementById("pop_up3");

        function openfeed_back()
        {
            var car=document.getElementById("car").value;
            var branch=document.getElementById("branch").value;
            var type=document.getElementById("type").value;
            var dealer=document.getElementById("dealer").value;
            var user=document.getElementById("user").value;
            var phone=document.getElementById("phone").value;
            var add=document.getElementById("add").value;
            var state=document.getElementById("state").value;
            var city=document.getElementById("city").value;
            var mail=document.getElementById("mail").value;
            var grievance=document.getElementById("grievance").value;
            var pincode=document.getElementById("pincode").value;

            //if(car=="" && branch=="" && dealer=="" && type=="" && user=="" && phone=="" && add=="" && state=="" && city=="" && mail=="" && grievance=="" && pincode=="")
            if(car=="")
                alert("Please Fill Car Name !");
            else if(branch=="")
                alert("Please Select Branch !");
            else if(dealer=="")
                alert("Please Fill Dealer !");    
            else if(type=="")
                alert("Please Select Surname !");
            else if(user=="")
                alert("Please Fill User Name !");
            else if(phone=="")
                alert("Please Fill Phone No !");
            else if(phone.length!=10)
                alert("Invalid Phone number !");
            else if(add=="")
                alert("Please Fill Address !");
            else if(state=="")
                alert("Please Fill State !");
            else if(city=="")
                alert("Please Fill City !");
            else if(mail=="")
                alert("Please Fill Email !");
            else if(grievance=="")
                alert("Please Fill Grievance !");
            else if(pincode=="")
                alert("Please Fill Pincode !");
            else if(pincode.length!=6)
                alert("Invalid Pincode!");
            else
            {
                pop_up3.classList.add("open-popfeed");
            }
            
        }
        function closefeed_back() {
            pop_up3.classList.remove("open-popfeed");
        }
    </script>
     <!-- validation -->
     <script>
        // Example starter JavaScript for disabling form submissions if there are invalid fields
        (function () {
            'use strict'

        // Fetch all the forms we want to apply custom Bootstrap validation styles to
        var forms = document.querySelectorAll('.needs-validation')

        // Loop over them and prevent submission
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
                }

                form.classList.add('was-validated')
            }, false)
            })
        })()
    </script>

