    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
          .navbar {
            backdrop-filter: blur(50px);
            position: fixed;
            background-color: #ffffff;
            width: 100%;
            height: 80px;
            top: 0;
            z-index: 1;
        }

        .nav-link {
            color: rgb(0, 0, 0);
            font-family:math;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-inline: 25px;
            position: relative;
            top: 12px;
            left: 20px;
            margin-top: 65px;
        }

        .nav-link:hover {
            color: rgb(255, 0, 0);
        }

        .header-logo {
            width: 100%;
            height: 200px;
            margin-inline: 15px;
            color: rgb(255, 255, 255);
        }

        .nav-profile {
            position: fixed;
            right: 2%;
            text-align: center;
            top: 20%;
            border: none;
            height: 50px;
            width: 50px;
            border-radius: 50%;
            background-color: #b54646;
            color: white;
            font-size: 25px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: 500;
            text-decoration: none;
            mix-blend-mode: hard-light;
        }
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
            z-index: 1;
            /* right: 115px; */
            left: 560px;
            top: 52px;
        }
        .dropdown-content a {
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }
        .dropdown-content a {
            background-color: #f1f1f1
        }

        .dropdown .dropdown-content {
            display: block;
        }
        .sing-out{
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            text-decoration: none;
            display: block;
            margin-left: 22px;
            margin-top: -18px;
        }
        .log
        {
            position: absolute;
            right: 10%;
        }
        /* .profile {
            position: absolute;
           
            object-fit: contain;
            mix-blend-mode: hard-light;
            border-radius: 73%;
            width: 50px;
            left: 650px;
            top: -14px;
        } */
    </style>
    <script>
        $(document).ready(function(){
            $('#pop_pass').hide();
            $('#contain').hide();
            $('#Profile').click(function()
            {
                $('#contain').toggle();
            });
            $('#change_password').click(function(){
                $('#pop_pass').toggle();
            });
        });
    </script>
</head>
