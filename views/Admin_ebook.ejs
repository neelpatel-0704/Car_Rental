<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Book</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
         /* body {
            background-image: url("/image14");
            background-repeat: no-repeat;
            background-size: cover;
        } */
        .e-book-img {
            position: relative;
            margin-bottom: 2%;
            width: 250px;
            height: 150px;
            object-fit: cover;
        }

        /* .e-book-img:hover{
        transform:scale(1.1);
        transition: 0.6s;
        border:2px solid red;
        border-radius: 10px;
    } */
        .e-book-car {
            font-size: 24px;
            position: relative;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: bold;
            left: 200px;
            top: 20px;
            text-align: center;
        }

        .e-book-price {
            position: relative;
            left: 200px;
            top: 20px;
            text-align: center;
            font-size: 20px;
            font-family: sans-serif;
            font-weight: 600;
        }

        .e-book-fuel {
            position: relative;
            text-align: center;
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: 400;
            left: 200px;
            top: 20px;
        }

        .e-book-txt {
            position: relative;
            width: 70%;
            height: 40px;
            border-radius: 5px;
            border: 1px solid black;
            left: 15%;
        }

        .e-book-div {
            border: 1px solid black;
            border-radius: 2px;
            margin-bottom: 5%;
        }

        .e-book-div:hover {
            /* transform:scale(1.1);
        transition: 0.6s; */
            border: 2px solid red;
            border-radius: 2px;
            box-shadow: 0px 3px 7px;
        }
        .mydiv:hover
        {
            border: 1px solid black;
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <div>
        <div><%-include('Admin_header')%></div><br><br><br>
        <div class="container mt-5">
            <h1>Your Car Booking Here</h1><br><hr>
            <div class="row mt-5"> 
                <%
                if(data.length>0)
                {
                    data.forEach(function(data){
                %>
                <div class="col-lg-4 text-center mydiv">
                    <image src="Images/<%= data.Car_img%>" style="position: relative;height: 200px;width: 100%;object-fit: contain;"><br>
                    <h5 class="text-center"><%=data.Car_name%></h5>
                    <h5 class="text-center"><%=data.Car_price%></h5>
                    <h5 class="text-center"><%=data.Fuel_type%></h5>
                    <button class="btn btn-outline-dark mb-5">Book Now</button>
                </div>
                <%
                    });
                }
                %>
                
            </div>
        </div>
        <div class="mt-5"><%-include('myfooter')%></div>
    </div>
</body>

</html>