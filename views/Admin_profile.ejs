<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        body {
            background-image: url("/image14");
            background-repeat: no-repeat;
            background-size: cover;
        }
        .input-box{
            border: none;
        }
        .pen{
            position: relative;
            top: -32px;
            left: 826px;
        }
        
        /* POP POP BOX */

        .popup-reg {
            width: 400px;
            background-color: white;
            border-radius: 6px;
            position: fixed;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.1);
            text-align: center;
            padding: 0 30px 30px;
            color: #333;
            visibility: hidden;
            transition: transform 0.4s, top 0.4s;
            z-index: 1;
            border: 1px solid black;
            box-shadow: 0px 10px 10px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
        }

        .popup-reg img {
            width: 70px;
            height: 70px;
            /* margin-top: -50px; */
            margin-top: 20px;
            border-radius: -50px;
        }

        .popup-reg h2 {
            font-size: 38px;
            font-weight: 500;
            margin: 30px 0 10px;
        }

        .popup-reg button {
            width: 100%;
            margin-top: 50px;
            padding: 10px 0;
            background-color: #198754;
            color: white;
            border: 0;
            outline: none;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);
        }

        .open-popreg {
            visibility: visible;
            top: 50%;
            transform: translate(-50%, -50%) scale(1);
        }

    </style>
    <script>
        $(document).ready(function () {
            $('#d1').hide();
            $('#link2').click(function()
            {
                $('#d1').toggle();
            });
        });
    </script>
</head>
<body>
    <div><%-include('Admin_header')%></div>
    <br><br><br><br><br>
    <div>
        <form action="http://localhost:3000/Admin_profile/update_pro" method="POST">
        <div class="container">
            <div class="row">
                <div class="col-sm-4" align="center">
                    <image src="/profile5"  class="w3-round-small" alt="Not found" style="width:100%;height:50%;object-fit: contain;"></image>
                </div>
                <div class="col-sm-8">
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="user_name" value="<%= Users %>" placeholder="NAME"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">NAME</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="email" value="<%= Emails %>" placeholder="EMAIL"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">EMAIL</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="ph_no" value="<%= Phone_nos %>" placeholder="PHONE NO"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">PHONE NO</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="pwd" value="<%= Passwords %>" placeholder="PASSWORD"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">PASSWORD</label>
                    </div><br>
                    <!-- <div>
                        <input type="checkbox" name="update_confirm" style="height: 28px;width: 21px;"><span style="font-size: larger;position: relative;top: -7px;right: -12px;">Are Sure For Updateing Your Profile.</span>
                    </div><br> -->
                    <div>
                        <input type="submit" class="btn btn-outline-success" value="Update" style="height: 45px;width: 134px;font-size: 21px;" onclick="opensubmit()">
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>
    <br>
    <div class="mt-5"><%- include('myfooter') %></div>
    <div>
        <div class="popup-reg" id="pop_up">
            <img src="/check" height="5%" width="5%">
            <h2>Thank you</h2>
            <p>your details have been successfully updated..</p>
            <a href="http://localhost:3000/Admin_profile"><button type="submit" onclick="closesubmit()">ok</button></a>
        </div>
        <script>
            let pop_up = document.getElementById("pop_up");

            function opensubmit() {
                pop_up.classList.add("open-popreg");
            }

            function closesubmit() {
                pop_up.classList.remove("open-popreg");
            }
        </script>

    </div>

</body>
</html>