<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" type="x-icon" href="/image2">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NK Motor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        .txt2 {
            background-color: #ebebebb8;
            font-size: 16px;
            border: 1px solid #ebebebb8;
            border-radius: 0px;
        }
        
        /* popup box */

        .popup-admin {
            width: 400px;
            background-color: white;
            border-radius: 6px;
            position: fixed;
            
            left: 50%;
            transform: translate(-50%, -50%) scale(0.1);
            text-align: center;
            padding: 0 30px 30px;
            color: #333;
            visibility: hidden;
            transition: transform 0.4s, top 0.4s;
            z-index: 1;
            border: 1px solid black;
            box-shadow: 0px 10px 10px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
        }

        .popup-admin img {
            width: 70px;
            height: 70px;
            /* margin-top: -50px; */
            margin-top: 20px;
            border-radius: -50px;

        }

        .popup-admin h2 {
            font-size: 38px;
            font-weight: 500;
            margin: 30px 0 10px;
        }

        .popup-admin button {
            width: 100%;
            margin-top: 50px;
            padding: 10px 0;
            background-color: #198754;
            color: white;
            border: 0;
            outline: none;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);
        }

        .open-popadmin {
            visibility: visible;
            top: 50%;
            transform: translate(-50%, -50%) scale(1);
        }
        .img_1{
            filter: drop-shadow(2px 4px 6px black);
        }
    </style>
</head>
<body>
    <div>
        <%- include('Admin_header') %>
    </div><br><br>
    <form action="http://localhost:3000/Add_car/Show_addcar" method="POST" enctype="multipart/form-data">
    <div class="container mt-5">
        <div class="row">
            <div class="col-sm-6 mt-5"><br><br>
                <div class="form-group">
                    <input type="file" name="car_image" id="input-files" class="form-control-file  txt2" style="width: 100%;"/>
                </div><br>
                <div class="form-group">
                    <input type="text" class="form-control txt2" name="car_name" placeholder="ENTER CAR NAME*">
                </div><br>
                <div class="form-group">
                    <input type="number" class="form-control txt2" name="car_price" placeholder="ENTER CAR PRICE*">
                </div><br>
                <div class="form-group">
                    <select class="form-control txt2" name="fuel_type">
                        <option>Diesel</option>
                        <option>Petrol</option>
                        <option>Compressed Natural Gas (CNG)</option>
                        <option>Electric Vehicle (EV)</option>
                    </select>
                </div><br>
                <div class="form-group">
                    <input type="text" class="form-control txt2" name="contain" placeholder="ENTER CAR CONTAIN*">
                </div><br>
               
                <div class="form-group">
                    <input type="submit" class="btn btn-outline-primary" value="SUBMIT" onclick="opensubmit()">
                </div><br>
            </div>
            <div class="col-lg-6">
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <image src="/img-malik" width="80%" class="img_1"></image>
            </div>
        </div>
    </div>  
    </form>
    <div class="mt-4">
        <%- include('myfooter') %>
    </div>
    <div class="popup-admin" id="pop_up">
        <img src="/check" height="5%" width="5%">
        <h2>Thank you</h2>
        <p>your details have been successfully submited.</p>
        <a href="http://localhost:3000/Admin"><button type="submit" onclick="closesubmit()" class="btn btn-outline-success">Ok</button></a>
    </div>

    <script>
        let pop_up = document.getElementById("pop_up");

        function opensubmit()
        {
            pop_up.classList.add("open-popadmin");
        }
        function closesubmit() 
        {
            pop_up.classList.remove("open-popadmin");
        }
    </script>
    
</body>
</html>