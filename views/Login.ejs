<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        .forget-password {
            position: absolute;
            right: 51px;
            color: black;
            text-decoration: none;
            font-family: system-ui;
            font-weight: 600;
            font-variant: small-caps;
        }

        .forget-password:hover {
            color: red;
        }

        /* .login-button {
            border-radius: 5px;
            color: black;
            background-color: #f3f3f3;
            font-family: system-ui;
            font-weight: 600;
            font-variant: small-caps;
        } */
        .login-button {
            border-radius: 15px;
            border: white;
            color: black;
            background-color: #f3f3f3;
            font-size: 20px;
        }

        .login-p {
            font-family: system-ui;
            font-size: 16px;
            font-weight: 400;
        }

        .login-h1 {
            font-family: system-ui;
            font-size: 35px;
            font-variant: small-caps;
            font-weight: 700;
        }

        .img-login {
            width: 100%;
            height: 570px;
            filter: drop-shadow(2px 4px 6px black);

        }

        .login-link {
            color: black;
            text-decoration: none;
        }

        .login-link:hover {
            color: red;
        }

        .login-social-icon {
            height: 20px;
            height: 20px;
            margin-inline: 5px;
        }

        .login-social-icon:hover {
            transform: scale(1.5);
            transition: 0.5s;
        }

        .login-txt {
            border: none;
            border-bottom: 2px solid black;
            outline: none;
            box-shadow: none;
            width: 60%;
            padding: 5px;
        }
    </style>
</head>

<body>
    <form action="http://localhost:3000/Login/checklogin" method="POST">
        <div id="login">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-sm-7 mt-5">
                        <image src="/logins" class="img-login">
                    </div>
                    <div class="col-sm-5 mt-5">
                        <!-- flash message -->
                        <% if(message.length > 0) { %>
                            <div class="alert alert-danger">
                                <%= message %>
                            </div>
                            <% } %>
                        <h1 class="login-h1">Welcome Back :)</h1>
                        <p class="login-p">To Keep Connected with us please login with your personal information by User
                            name and password🔔</p>
                        <div class="form-group">
                            <input type="text" class="login-txt" name="user_name" placeholder="User Name">
                        </div><br>
                        <div class="form-group">
                            <input type="password" class="login-txt" name="pwd" placeholder="Password">
                        </div>
                        <div><br>
                            <!-- <input type="checkbox"> Remember Me -->
                            <a href="http://localhost:3000/ForgetPass" class="forget-password">Forget Password?</a>
                        </div><br>
                        <div>
                            <input type="submit" value="Login Now" class="btn btn-outline-primary">&nbsp;&nbsp;
                            <a href="http://localhost:3000/Registration" class="btn btn-outline-primary">Create Account</a>&nbsp;&nbsp;
                            <a href="http://localhost:3000" class="btn btn-outline-danger">Cancel</a>
                        </div><br>
                        <div>
                            <p class="login-p">or you can join with</p>
                            <image src="/google" class="login-social-icon">
                            <image src="/facebook" class="login-social-icon">
                            <image src="/twitter" class="login-social-icon">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</body>

</html>