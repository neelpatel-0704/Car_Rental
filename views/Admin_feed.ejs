<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Data</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <style>
        .my-tbl{
            position: relative;
            text-align: center;
            border-radius: 10px;
            font-size: 17px;
            font-family:math;
            font-variant: all-petite-caps;
            box-shadow:3px -3px 3px 3px rgb(234, 232, 232);
        }
        .my-h1{
            position: relative;
            font-size: 25px;
            top: 20px;
            left: 10px;
            font-family: sans-serif;
            font-weight: lighter;
            font-variant: all-petite-caps;
        }
        .my-search{
            position: relative;
            padding: 10px;
            /* height: 40px;
            width: 20%;
            border-radius: 5px;
            border: 1px solid lightgray; */
            font-size: 14px;
            font-family: math;
            font-variant: all-petite-caps;
        }
        .my-btn{
            position: relative;
            width: 10%;
            font-family: math;
            font-variant: all-petite-caps;
        }
    </style>
</head>
<body>
    <div><%-include('Admin_header')%></div>
    <div>
        <form action="http://localhost:3000/Admin_feed/Feed_Data" method="POST">
            <br>
            <div class="container mt-5">
                <h1 class="my-h1">Feed Back Details</h1><br>
                
                    <!-- flash message -->
                    <% if(message.length > 0) { %>
                        <div class="alert alert-danger mt-3">
                            <%= message %>
                        </div>
                    <% } %>
                   
                    <select class="form-select mt-4 service-txt" name="Bra_id">
                        <% if(data1.length>0)
                            {
                            data1.forEach(function(data1){
                            %>
                            <option value="" hidden>Enter Branch*</option>
                            <option value="<%= data1.Branch_id %>">
                                <%= data1.Branch_name%>
                            </option>
                            <% }); } %>
                    </select>
                    
                    
                    <!-- <input type="search" class=" my-search" placeholder="Record Search Here"> -->
                    <button class="btn btn-outline-primary mt-3 my-btn">Search</button>
                    <a href="http://localhost:3000/Admin_feed" class="btn btn-success mt-3 my-btn">SHOW ALL</a>
                
            </div>

            <div class="container"><br><br>
                <h1 class="mt-5">Feed Back data</h1>
                <table class="mt-5 table my-tbl">
                    <tr>
                        <td colspan="6">Feed Back Data</td>
                    </tr>
                    <tr>
                        <th>No</th>
                        <th>Client</th>
                        <th>Branch</th>
                        <th>Car Name</th>
                        <th>Grievance</th>    
                    </tr>
                    <%
                    if(data.length>0)
                    {
                        data.forEach(function(data){
                    %>
                    <tr>
                        <td><%= data.Feedback_id %></td>
                        <td><%= data.User_name %></td>
                        <td><%= data.Branch_name %></td>
                        <td><%= data.Car_name %></td>
                        <td><%= data.Grievance %></td>
                    </tr>
                    <%
                    });
                    }
                    else
                        {
                        %>
                    <tr>
                        <td colspan="9">No data Found</td>
                    </tr>
                    <%
                    }
                    %>
                </table>    
            </div>
        </form>
    </div>
    <!-- <div class="mt-5">
        <%- include('myfooter') %>
    </div> -->
</body>
</html>