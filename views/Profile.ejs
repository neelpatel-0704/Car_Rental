<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        body {
            background-image: url("/image14");
            background-repeat: no-repeat;
            background-size: cover;
        }
        .navbar {
            backdrop-filter: blur(50px);
            position: fixed;
            background-color: #ffffff;
            width: 100%;
            height: 80px;
            top: 0;
            z-index: 1;
        }

        .nav-link {
            color: rgb(0, 0, 0);
            font-family: Perpetua Titling MT;
            font-size: 18px;
            font-weight: 500;
            letter-spacing: 3px;
            margin-inline: 25px;
            position: relative;
            top: 12px;
        }

        .nav-link:hover {
            color: rgb(255, 0, 0);
            transform: translateY(-3px);
            font-size: 15px;
            transition: 0.3s;
        }

        .header-logo {
            width: 100%;
            height: 60px;
            border-radius: 50px;
            margin-inline: 15px;
        }

        .nav-profile {
            position: fixed;
            right: 2%;
            text-align: center;
            top: 20%;
            border: none;
            height: 50px;
            width: 50px;
            border-radius: 50%;
            background-color: #b54646;
            color: white;
            font-size: 25px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: 500;
            text-decoration: none;
            mix-blend-mode: hard-light;
        }

        .k {
            color: white;
            font-size: 43px;
            font-weight: 700;

        }
        .pro{
            color: white;
            font-family: Perpetua Titling MT;
            font-size: 18px;
            font-weight: 500;
            letter-spacing: 2px;
            margin-inline: 25px;
            position: relative;
            top: 20px;
            left: 240%;
        }
/*      
        .profile {
            position: absolute;
            top: 31%;
            right: 1%;
            object-fit: contain;
            mix-blend-mode: hard-light;
            border-radius: 73%;
            width: 50px;
            left: 761px;
            top: -14px;
        } */
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
            z-index: 1;
            /* right: 115px; */
            left: 560px;
            top: 52px;
        }
        .dropdown-content a {
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }
        .dropdown-content a {
            background-color: #f1f1f1
        }

        .dropdown .dropdown-content {
            display: block;
        }
        .sing-out{
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            text-decoration: none;
            display: block;
            margin-left: 22px;
            margin-top: -18px;
        }
        .input-box{
            border: none;
        }
        .pen{
            position: relative;
            top: -32px;
            left: 826px;
        }
        
        /* POP POP BOX */

        .popup-reg {
            width: 400px;
            background-color: white;
            border-radius: 6px;
            position: fixed;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.1);
            text-align: center;
            padding: 0 30px 30px;
            color: #333;
            visibility: hidden;
            transition: transform 0.4s, top 0.4s;
            z-index: 1;
            border: 1px solid black;
            box-shadow: 0px 10px 10px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
        }

        .popup-reg img {
            width: 70px;
            height: 70px;
            /* margin-top: -50px; */
            margin-top: 20px;
            border-radius: -50px;
        }

        .popup-reg h2 {
            font-size: 38px;
            font-weight: 500;
            margin: 30px 0 10px;
        }

        .popup-reg button {
            width: 100%;
            margin-top: 50px;
            padding: 10px 0;
            background-color: #198754;
            color: white;
            border: 0;
            outline: none;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);
        }

        .open-popreg {
            visibility: visible;
            top: 50%;
            transform: translate(-50%, -50%) scale(1);
        }

    </style>
    <script>
        $(document).ready(function () {
            $('#d1').hide();
            $('#contain').hide();
            $('#Profile').click(function()
            {
                $('#contain').toggle();
            });

            $('#link2').click(function()
            {
                $('#d1').toggle();
            });
        });
    </script>
</head>
<body>
    <div>
        <nav>
            <nav class="navbar navbar-expand-sm">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <image src="/headerlogo" class="header-logo">
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/E_book" class="nav-link">Show_Car</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/Feed_back" class="nav-link">Feed_back</a>
                    </li>
                    <li class="nav-item">
                         <% if(Users.length>0){ %>
                            <div class="dropdown">
                                <image src="/image37" class="nav-profile" id="Profile" onclick="openpop()" />
                                <div class="dropdown-content" id="contain">
                                    <a href="http://localhost:3000/Profile">Profile</a>
                                    <a href="javascript:;" id="link2">History</a>
                                    <div id="d1" style="margin-top: -20px;margin-left: 10px;">
                                        <a href="http://localhost:3000/Service_history" id="link2-1">> Service</a>
                                        <a href="http://localhost:3000/Test_drive_history" id="link2-2" style="margin-top: -15px;">> Test Drive</a>
                                        <a href="http://localhost:3000/Feed_back_history" id="link2-3" style="margin-top: -15px;">> Feed Back</a>
                                    </div>
                                    <a href="http://localhost:3000/Service/Logout"><i class="fa fa-sign-out"><span class="sing-out">Sign Out</span></i></a>  
                                </div>
                            </div>
                        <% }%>
                    </li>
                </ul>
            </nav>
        </nav> 
    </div>
    <br><br><br><br><br><br>
    <div>
        <form action="http://localhost:3000/Profile/update_profile" method="POST">
        <div class="container">
            <div class="row">
                <div class="col-sm-4" align="center">
                    <image src="/profile5"  class="w3-round-small" alt="Not found" style="width:100%;height:50%;object-fit: contain;"></image>
                </div>
                <div class="col-sm-8">
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="user_name" value="<%= Users %>" placeholder="NAME"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">NAME</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="email" value="<%= Emails %>" placeholder="EMAIL"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">EMAIL</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="ph_no" value="<%= Phone_nos %>" placeholder="PHONE NO"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">PHONE NO</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="state" value="<%= States %>" placeholder="STATE"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">STATE</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="city" value="<%= Citys %>" placeholder="CITY"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">CITY</label>
                    </div><br>
                    <div class="form-floating ">
                        <input type="text" class="form-control" id="floatingInput" name="pwd" value="<%= Passwords %>" placeholder="PASSWORD"><i class="fa fa-pencil pen" aria-hidden="true" ></i></input>
                        <label for="floatingInput">PASSWORD</label>
                    </div><br>
                    <!-- <div>
                        <input type="checkbox" style="height: 28px;width: 21px;"><span style="font-size: larger;position: relative;top: -7px;right: -12px;">Are Sure For Updateing Your Profile.</span>
                    </div><br> -->
                    <div>
                        <input type="submit" class="btn btn-outline-success" style="height: 45px;width: 134px;font-size: 21px;" value="Update" onclick="opensubmit()">
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>
    <br>
    <div class="mt-5"><%- include('myfooter') %></div>
    <div>
        <div class="popup-reg" id="pop_up">
            <img src="/check" height="5%" width="5%">
            <h2>Thank you</h2>
            <p>your details have been successfully updated..</p>
            <a href="http://localhost:3000/Profile"><button type="submit" onclick="closesubmit()">ok</button></a>
        </div>
        <script>
            let pop_up = document.getElementById("pop_up");

            function opensubmit() {
                pop_up.classList.add("open-popreg");
            }

            function closesubmit() {
                pop_up.classList.remove("open-popreg");
            }
        </script>

    </div>

</body>
</html>
