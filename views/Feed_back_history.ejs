<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
         .navbar {
            backdrop-filter: blur(50px);
            position: fixed;
            background-color: #ffffff;
            width: 100%;
            height: 80px;
            top: 0;
            z-index: 1;
        }

        .nav-link {
            color: rgb(0, 0, 0);
            font-family:math;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-inline: 25px;
            position: relative;
            top: 12px;
            left: 20px;
            margin-top: 65px;
        }

        .nav-link:hover {
            color: rgb(255, 0, 0);
        }

        .header-logo {
            width: 100%;
            height: 200px;
            margin-inline: 15px;
            color: rgb(255, 255, 255);
        }


        .nav-profile {
            position: fixed;
            right: 2%;
            text-align: center;
            top: 20%;
            border: none;
            height: 50px;
            width: 50px;
            border-radius: 50%;
            background-color: #b54646;
            color: white;
            font-size: 25px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: 500;
            text-decoration: none;
            mix-blend-mode: hard-light;
        }



        .k {
            color: white;
            font-size: 43px;
            font-weight: 700;

        }

        .pro {
            color: white;
            font-family: Perpetua Titling MT;
            font-size: 18px;
            font-weight: 500;
            letter-spacing: 2px;
            margin-inline: 25px;
            position: relative;
            top: 20px;
            left: 240%;
        }

        .profile {
            position: absolute;
            /* top: 31%; */
            /* right: 1%; */
            object-fit: contain;
            mix-blend-mode: hard-light;
            border-radius: 73%;
            width: 50px;
            left: 761px;
            top: -14px;
        }

        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
            z-index: 1;
            /* right: 115px; */
            left: 600px;
            top: 52px;
        }

        .dropdown-content a {
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }

        .dropdown-content a {
            background-color: #f1f1f1
        }

        .dropdown .dropdown-content {
            display: block;
        }

        .sing-out {
            font-size: 18px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            color: black;
            text-decoration: none;
            display: block;
            margin-left: 22px;
            margin-top: -18px;
        }

        .my-tbl {
            position: relative;
            text-align: center;
            border-radius: 10px;
            font-size: 17px;
            font-family: math;
            font-variant: all-petite-caps;
            box-shadow: 3px -3px 3px 3px rgb(234, 232, 232);
        }

        .my-h1 {
            position: relative;
            font-size: 25px;
            top: 20px;
            left: 10px;
            font-family: sans-serif;
            font-weight: lighter;
            font-variant: all-petite-caps;
        }

        .my-search {
            position: relative;
            padding: 10px;
            /* height: 40px;
            width: 20%;
            border-radius: 5px;
            border: 1px solid lightgray; */
            font-size: 14px;
            font-family: math;
            font-variant: all-petite-caps;
        }

        .my-btn {
            position: relative;
            width: 10%;
            font-family: math;
            font-variant: all-petite-caps;
        }
        .log
        {
            position: absolute;
            right: 10%;
        }
    </style>
    <script>
        $(document).ready(function () {
            $('#d1').hide();
            $('#contain').hide();
            $('#Profile').click(function () {
                $('#contain').toggle();
            });
            $('#link2').click(function () {
                $('#d1').toggle();
            });
        });
    </script>
</head>

<body>
    <div>
        <nav>
            <nav class="navbar navbar-expand-sm">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <image src="/headerlogo" class="header-logo">
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/E_book" class="nav-link">Show Cars</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/Feed_back" class="nav-link">Feed back</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/Feed_back_history" class="nav-link">History</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/Profile" class="nav-link">Profile</a>
                    </li>
                    <li class="nav-item log">
                        <a href="http://localhost:3000/Feed_back/Logout" class="nav-link log">Logout</a>
                    </li>
                </ul>
            </nav>
        </nav>
    </div>
    <br><br>
    <div>
        <form action="http://localhost:3000/Feed_back_history/Feed_Data_c" method="POST">
            <div class="container mt-5">
                <table class="mt-5 table my-tbl">
                    <h1 class="mt-5">Feed Back History</h1>
                    <tr>
                        <td colspan="6">Feed Back Data</td>
                    </tr>
                    <tr>
                        <th>No</th>
                        <th>Client</th>
                        <th>Branch</th>
                        <th>Car Name</th>
                        <th>Grievance</th>
                        <th>Action</th>
                    </tr>
                    <% if(data.length>0)
                        {
                        data.forEach(function(data){
                        %>
                        <tr>
                            <td>
                                <%= data.Feedback_id%>
                            </td>
                            <td>
                                <%= data.User_name%>
                            </td>
                            <td>
                                <%= data.Branch_name%>
                            </td>
                            <td>
                                <%= data.Car_name%>
                            </td>
                            <td>
                                <%= data.Grievance%>
                            </td>
                            <td><a href="/Feed_back_history/delete/<%= data.Feedback_id %>"
                                    class="btn btn-outline-danger">Delete</a>&nbsp;
                                <a href="/Feed_back_history/edit/<%= data.Feedback_id %>"
                                    class="btn btn-outline-info">Edit</a>
                            </td>
                        </tr>
                        <% }); } else { %>
                            <tr>
                                <td>No data Found</td>
                            </tr>
                            <% } %>
                </table>
            </div>
        </form>
    </div>
    <br><br>
    <div class="mt-5"><%- include('myfooter') %></div>
</body>

</html>