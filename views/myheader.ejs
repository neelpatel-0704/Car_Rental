<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    
    <style>
        .navbar {
            backdrop-filter: blur(50px);
            position: fixed;
            /* background-color: #0d1021; */
            background-color: rgb(255, 255, 255);
            width: 100%;
            height: 80px;
            top: 0;
            z-index: 1;
        }

        .nav-link {
            color: rgb(0, 0, 0);
            font-family:math;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-inline: 25px;
            position: relative;
            top: 12px;
            left: 20px;
            margin-top: 70px;
        }

        .nav-link:hover {
            color: rgb(255, 0, 0);
        }

        .header-logo {
            width: 100%;
            height: 200px;
            margin-inline: 15px;
            color: black;
        }

        .nav-profile {
            position: fixed;
            right: 2%;
            text-align: center;
            top: 20%;
            border: none;
            height: 40px;
            width: 40px;
            border-radius: 50%;
            background-color: #b54646;
            color: white;
            font-size: 25px;
            font-family: sans-serif;
            font-variant: all-petite-caps;
            font-weight: 500;
            text-decoration: none;
        }

        .i_1 {
            position: absolute;
            top: 20%;
            right: 1%;
            object-fit: contain;
            mix-blend-mode: hard-light;
            border-radius: 73%;
            width: 50px;
        }

        /* popup box */

        .popup {
            width: 400px;
            background-color: white;
            border-radius: 6px;
            /* position: absolute; */
            position: fixed;
            /* top: 0%; */
            right: -12%;
            transform: translate(-50%, -50%) scale(0.1);
            text-align: center;
            padding: 0 30px 30px;
            color: #333;
            visibility: hidden;
            transition: transform 0.4s, top 0.4s;
            z-index: 1;
            border: 1px solid black;
            box-shadow: 0px 10px 10px;

        }

        .popup img {
            width: 70px;
            /* margin-top: -50px; */
            margin-top: 10px;
            border-radius: -50px;

        }

        .popup h2 {
            font-size: 28px;
            font-weight: 500;
            margin: 10px 0 10px;
        }

        .popup button {
            width: 49%;
            margin-top: 30px;
            padding: 10px 0;
            background-color: #0d1021;
            color: white;
            border: 0;
            outline: none;
            font-size: 18px;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);
        }

        .open-pop {
            visibility: visible;
            top: 50%;
            transform: translate(-50%, -50%) scale(1);
        }

        h5 {
            text-align: left;

        }

        h6 {
            text-align: left;

        }

        .pop-font {
            font-family: sans-serif;
            font-variant: all-petite-caps;
        }

        .pop-logo {
            border-radius: 50%;
            background-color: #0d1021;
            height: 70px;
            width: 70px;
            /* margin-top: -50px; */
            margin-top: 14px;
            border-radius: -50px;
            position: relative;
            right: -39%;
        }

        .k {
            color: white;
            font-size: 43px;
            font-weight: 700;

        }
        .log
        {
            position: absolute;
            right: 10%;
        }
    </style>
</head>

<body>
    <div>
        <nav>
            <nav class="navbar navbar-expand-sm">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <image src="/headerlogo" class="header-logo">
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/E_book" class="nav-link">Show Cars</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://localhost:3000/Feed_back" class="nav-link">Feed back</a>
                    </li>
                    <li class="nav-item log">
                        <a href="http://localhost:3000/Login" class="nav-link log">Login</a>
                    </li>
                </ul>
            </nav>
        </nav>
        <div class="popup" id="popup">
            <div class="pop-logo"><span class="k">K</span></div>
            <h2 class="pop-font"><span contenteditable> <h1></h1></span>&nbsp;<i class="fa fa-pencil" aria-hidden="true"
                    style="font-size: 20px;"></i></h2>
            <h6><span class="pop-font">Gmail :-&nbsp;&nbsp;</span><span contenteditable>#</span>&nbsp;<i class="fa fa-pencil" aria-hidden="true"></i>
            </h6>
            <h6 class="pop-font">Phone No :-&nbsp;&nbsp;<span>#</span>&nbsp;<i
                    class="fa fa-pencil" aria-hidden="true"></i></h6>
            <h6 class="pop-font">Password :-&nbsp;&nbsp;<span contenteditable>#</span>&nbsp;<i
                    class="fa fa-pencil" aria-hidden="true"></i></h6>
            <h6 class="pop-font"><i class="fa fa-google" aria-hidden="true">&nbsp;&nbsp;<span class="pop-font">Manage
                        Your Google Account</span></i></h6>
            <h6 class="pop-font"><i class="fa fa-sign-out" aria-hidden="true">&nbsp;&nbsp;<span class="pop-font">Sign
                        Out</span></i></h6>
            <hr style="margin-left: -41%;z-index: 1;width: 117%;background-color: black;">
            <h5 class="pop-font">Other profile</h5><span style="position: absolute;right: 5%;bottom: 31%;"><i
                    class="fa fa-cog" aria-hidden="true"></i></span>
            <h5 class="pop-font"><i class="fa fa-user-circle" aria-hidden="true"></i>&nbsp;&nbsp;<span
                    style=" font-size: 15px;">Guest</span></h5>
            <h5 class="pop-font"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;&nbsp;&nbsp;<span
                    style=" font-size: 15px;">Add</span></h5>
            <!-- <p>your details have been successfully submited..</p> -->
            <button type="submit" onclick="closepop()">ok</button>
            <button type="submit" onclick="closepop()">Cancel</button>
        </div>
        <script>
            let popup = document.getElementById("popup");

            function openpop() {
                popup.classList.add("open-pop");
            }

            function closepop() {
                popup.classList.remove("open-pop");
            }
        </script>
    </div>
</body>